{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "aid guard session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "aid guard inline",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "aid guard generic",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "aid guard sensitive",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "aid guard models",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
